# Copy this file to ".env" (same folder) and fill in real values. NEVER commit ".env".

PORT=5000
NODE_ENV=development

# MongoDB Atlas (recommended) — include the database name (/pms) before the "?".
# URL-encode special characters in the password (e.g. @ -> %40).
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<your-cluster>.mongodb.net/pms?retryWrites=true&w=majority
# Local MongoDB instead:
# MONGODB_URI=mongodb://localhost:27017/pms

# Only if you get "querySrv ECONNREFUSED" (your network refuses DNS SRV lookups from Node):
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=24h

# Optional: password for the seeded admin (required when NODE_ENV=production)
# ADMIN_SEED_PASSWORD=
