# Copy this file to ".env" (same folder) and fill in real values. NEVER commit ".env".

PORT=5000
NODE_ENV=development

# MongoDB Atlas (recommended) — include the database name (/pms) before the "?".
# URL-encode special characters in the password (e.g. @ -> %40).
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<your-cluster>.mongodb.net/pms?retryWrites=true&w=majority
# Local MongoDB instead:
# MONGODB_URI=mongodb://localhost:27017/pms

# Only if you get "querySrv ECONNREFUSED" (your network refuses DNS SRV lookups from Node):
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=24h

# E-mail for the verification link (registration) and the password reset link.
# Gmail is free: turn on 2-Step Verification for the account, create an "App password"
# (Google Account > Security > App passwords) and use it as SMTP_PASS.
# Without SMTP_USER / SMTP_PASS the e-mails are printed in the server console instead (development only).
# SMTP_USER=your.project.account@gmail.com
# SMTP_PASS=
# Public address of the site, used inside the e-mailed links (default: http://localhost:PORT)
# APP_URL=http://localhost:5000
# Another provider, or a different sender name:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM="Placement Management System" <your.project.account@gmail.com>

# Optional: set to 1 when deployed behind a reverse proxy (Render, Railway, nginx...) so rate
# limiting sees real client IPs.
# TRUST_PROXY=1

# Optional: only if the frontend is hosted on a DIFFERENT origin than this server
# (comma-separated). By default cross-origin API access is disabled.
# CLIENT_ORIGIN=https://your-frontend.example.com

# The admin account is created with "npm run create-admin" (it asks for an e-mail and a password).
# Only for scripted set-ups: ADMIN_EMAIL and ADMIN_PASSWORD (and ADMIN_NAME) skip the prompts. Do not keep them in .env.
